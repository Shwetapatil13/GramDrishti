# Copy to backend/.env and fill in. All values are optional; defaults shown.

# Google Earth Engine (required for live satellite data)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_CREDENTIALS_PATH=./credentials/gee_credentials.json

# Google Gemini (required for AI narratives; falls back to local Ollama / templates)
GEMINI_API_KEY=

OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

DEBUG=true
# Set to true to run without Earth Engine credentials
USE_MOCK_DATA=false

# Hackathon demo access
DEMO_MODE=false
DEMO_TOKEN=

# Farm boundary provider: agstack | mock
FARM_PROVIDER=agstack
